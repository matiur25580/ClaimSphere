NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/claimsphere
LOG_LEVEL=info
# Replace with a unique random secret of at least 32 characters in every deployed environment.
JWT_ACCESS_SECRET=development-only-change-this-secret-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
